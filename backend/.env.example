# ---------------------------------------------------------------------------
# CodeAtlas backend environment — copy this file to `.env` and fill in values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# dev enables useful warnings; leave unset (or "production") for deploys
FASTAPI_ENV=development

PROJECT_NAME="CodeAtlas"

# 256-bit random value, e.g. `openssl rand -hex 64`. CHANGE THIS.
SECRET_KEY=changethis

# Postgres (or sqlite:///./codeatlas.db for a local zero-dependency run)
DATABASE_URL=postgresql://postgres:codeatlas@localhost:5432/app

# JWT lifetime in minutes (default: 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS origin for the React dev server
FRONTEND_HOST=http://localhost:5173

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES="read:user repo"
# The frontend route that receives ?code= after GitHub redirects the browser
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Secret used to verify GitHub webhook signatures (X-Hub-Signature-256).
# Set in the GitHub repo/webhook settings UI. CHANGE THIS.
GITHUB_WEBHOOK_SECRET=changethis