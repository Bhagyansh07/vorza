# ---------------------------------------------------------------------------
# Vorza backend environment — copy this file to `.env` and fill in values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# dev enables useful warnings; leave unset (or "production") for deploys
FASTAPI_ENV=development

PROJECT_NAME="Vorza"

# 256-bit random value, e.g. `openssl rand -hex 64`. CHANGE THIS.
SECRET_KEY=changethis

# Postgres (or sqlite:///./vorza.db for a local zero-dependency run)
DATABASE_URL=postgresql://postgres:vorza@localhost:5432/app

# JWT lifetime in minutes (default: 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS origin for the React dev server
FRONTEND_HOST=http://localhost:5173
# Additional browser origins allowed to call the API (comma-separated). In
# production this lists the live Vercel aliases that serve the frontend;
# FRONTEND_HOST is always allowed on top of these.
CORS_ORIGINS=https://vorza-app.vercel.app,https://getvorza.vercel.app,https://vorza-sigma.vercel.app,https://vorza-bhagyansh.vercel.app

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES="read:user repo"
# Where GitHub redirects the browser after authorize. Must be the frontend page
# that reads ?code=&state= and echoes state back to POST /auth/github/callback.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/login

# Secret used to verify GitHub webhook signatures (X-Hub-Signature-256).
# Set in the GitHub repo/webhook settings UI. There is NO default: leave it
# unset and POST /webhooks/github returns 503 instead of accepting an
# unverifiable payload. Generate with `openssl rand -hex 32`.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI pull-request review (optional)
# ---------------------------------------------------------------------------
# Without a key the webhook still verifies, but reviews are skipped and the
# reason is logged. The `openai` package is always installed; only the key and
# the spend are optional.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Realtime (optional)
# ---------------------------------------------------------------------------
# Falls back to an in-process pub/sub when unset, which is fine for the free
# single-instance deploy. Set a real Redis URL only if you scale past one
# instance, otherwise presence stays process-local.
# REDIS_URL=redis://localhost:6379/0