# Vorza root env — copy to .env at repo root for docker-compose.
# All values here are dev defaults. Never commit real secrets.

# Postgres (docker-compose)
POSTGRES_PASSWORD=vorza

# Backend
FASTAPI_ENV=development
SECRET_KEY=change-me-in-prod
