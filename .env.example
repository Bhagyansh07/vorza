# Vorza root env — copy to .env at repo root for docker-compose.
# All values here are dev defaults. Never commit real secrets.

# Postgres (docker-compose)
POSTGRES_PASSWORD=vorza

# Backend
FASTAPI_ENV=development
SECRET_KEY=change-me-in-prod
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=change-me-in-prod
REDIS_URL=redis://redis:6379/0
# AI review: a paid or free OpenAI-compatible provider. Empty BASE_URL = OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Frontend
FRONTEND_HOST=http://localhost:5173