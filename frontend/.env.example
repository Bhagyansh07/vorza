# Vorza frontend env — copy to .env to configure

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# GitHub OAuth: the backend owns the authorize URL (GET /auth/github/login),
# so there is nothing to configure here. The browser is redirected back to
# /login?code=&state=; the frontend echoes state to POST /auth/github/callback.

# Serve fixtures instead of hitting the API. Leave false in production: the
# graph has a second, older fetch layer that silently defaults to true when
# this is unset, which is why the default is 'true' here only for local dev.
VITE_USE_MOCKS=true

# REQUIRED IN PRODUCTION. The origin this site is served from, no trailing
# slash. Used to build:
#   - the <link rel="canonical"> and og:url at runtime (src/lib/seo.ts)
#   - robots.txt and sitemap.xml, generated at build time (vite.config.ts)
#
# In the browser the live origin is used when this is unset, so preview builds
# describe themselves correctly. It still needs setting for the build, because
# robots.txt and sitemap.xml are static files and cannot know the hostname.
# A missing value makes the build warn and points both at localhost, which
# fails silently once indexed.
VITE_SITE_URL=