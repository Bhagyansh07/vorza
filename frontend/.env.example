# CodeAtlas frontend env — copy to .env to configure
# Base URL of Agent 1's FastAPI backend
VITE_API_URL=http://localhost:8000

# When truthy, the API layer serves in-browser mock data instead of hitting the
# backend. Useful while Agent 1's REST API is still landing. Swap to false once
# the backend is up.
VITE_USE_MOCKS=true

# GitHub OAuth entrypoint — the backend owns the callback (POST /auth/github/callback)
VITE_GITHUB_OAUTH_URL=https://github.com/login/oauth/authorize

# GitHub OAuth app used for the login redirect flow.
# The agent's backend owns the /auth/github/callback route; it redirects back
# to the frontend with ?token=... or hands the code to the local flow.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback