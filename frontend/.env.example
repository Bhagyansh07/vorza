# Vorza frontend env — copy to .env to configure
# Base URL of Agent 1's FastAPI backend
VITE_API_URL=http://localhost:8000

# GitHub OAuth: the backend owns the authorize URL (GET /auth/github/login),
# so there is nothing to configure here. The browser is redirected back to
# /login?code=&state=; the frontend echoes state to POST /auth/github/callback.
VITE_USE_MOCKS=true