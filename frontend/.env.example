# Vorza frontend env - copy to .env to configure.
#
# Precedence for VITE_API_URL, in order, highest first:
#   1. this file / .env.local        (per-developer, gitignored)
#   2. .env.production                (tracked, used by the Vercel build)
#   3. the dev fallback in src/lib/config.ts
# VITE_-prefixed values are baked into the browser bundle at BUILD time. They
# are not secrets - anything here is readable by anyone who loads the page.

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# GitHub OAuth: the backend owns the authorize URL (GET /auth/github/login),
# so there is nothing to configure here. The browser is redirected back to
# /login?code=&state=; the frontend echoes state to POST /auth/github/callback.

# Serve fixtures instead of hitting the API.
#
# Read once, in src/lib/config.ts:
#     useMocks: raw('VITE_USE_MOCKS', 'true').toLowerCase() === 'true'
#
# So only the literal string "true" (any case) turns mocks ON, and UNSET also
# turns them ON, because 'true' is the fallback. Set this to exactly "false" in
# production: a stray unset variable here serves invented repos behind a
# plausible-looking UI rather than erroring.
#
# An earlier graph fetch layer had a second, unrelated check
# (VITE_USE_MOCK !== "false") that nothing set, so it defaulted to mocks in
# production. That layer is gone; this is now the only switch. Do not add a
# second one - two switches is how the graph served fixtures while CI was green.
VITE_USE_MOCKS=true

# REQUIRED IN PRODUCTION. The origin this site is served from, no trailing
# slash. Used to build:
#   - the <link rel="canonical"> and og:url at runtime (src/lib/seo.ts)
#   - robots.txt and sitemap.xml, generated at build time (vite.config.ts)
#
# In the browser the live origin is used when this is unset, so preview builds
# describe themselves correctly. It still needs setting for the build, because
# robots.txt and sitemap.xml are static files and cannot know the hostname.
# A missing value makes the build warn and points both at localhost, which
# fails silently once indexed.
VITE_SITE_URL=